# Copy to ".env" only if you use a process manager that loads it; the app
# itself reads these straight from the environment. On Windows, the easiest
# way to set them is by editing start.bat.

# --- App ---
PORT=3000
OFFICIAL_WEBSITE_URL=https://www.your-hotel.com
ADMIN_PASSWORD=admin123

# --- Demo guest seeded on first run ---
SEED_DEMO_USER=true
DEMO_USERNAME=guest
DEMO_PASSWORD=guest123

# --- Storage ---
# mysql (default, works with XAMPP) or json (no database needed)
DB_DRIVER=mysql

# MySQL / MariaDB connection (defaults match a fresh XAMPP install).
# The database and tables are created automatically on first run.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_portal

# If DB_PORT is busy, the portal automatically falls back to these ports
# (comma-separated, tried in order). XAMPP users who moved MySQL to 3307
# need no extra config thanks to this.
DB_PORT_FALLBACKS=3307
